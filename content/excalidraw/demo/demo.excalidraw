      "originalText": "Dijkstra 逐轮过程",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "steps",
      "type": "text",
      "x": 1060,
      "y": 225,
      "width": 330,
      "height": 325,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1062,
      "version": 1,
      "versionNonce": 1062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783095000000,
      "link": null,
      "locked": false,
      "text": "1. 确定 A：d(A)=0，更新 B=4、C=2\n\n2. 确定 C：B=min(4,2+1)=3，E=10，D=12\n\n3. 确定 B：E=min(10,3+3)=6，D=min(12,3+5)=8\n\n4. 确定 E：F=6+3=9，D 保持 8\n\n5. 确定 D：经 D 到 F 为 8+6=14，不更新\n\n6. 确定 F：结束，回溯前驱得到最短路",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 确定 A：d(A)=0，更新 B=4、C=2\n\n2. 确定 C：B=min(4,2+1)=3，E=10，D=12\n\n3. 确定 B：E=min(10,3+3)=6，D=min(12,3+5)=8\n\n4. 确定 E：F=6+3=9，D 保持 8\n\n5. 确定 D：经 D 到 F 为 8+6=14，不更新\n\n6. 确定 F：结束，回溯前驱得到最短路",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "result",
      "type": "text",
      "x": 1060,
      "y": 575,
      "width": 330,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0",
      "roundness": null,
      "seed": 1063,
      "version": 1,
      "versionNonce": 1063,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783095000000,
      "link": null,
      "locked": false,
      "text": "结果：A → C → B → E → F，\n最短距离 = 2+1+3+3 = 9",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "结果：A → C → B → E → F，\n最短距离 = 2+1+3+3 = 9",
      "autoResize": true,
      "lineHeight": 1.25
    }
